---
const { title = "Minjoo's Home" } = Astro.props;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">Minjoo</a>
			<nav aria-label="Primary navigation">
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/projects">Projects</a>
				<a href="/posts">Posts</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<p>Minjoo's Home</p>
		</footer>
	</body>
</html>

<style>
	:root {
		color: #191919;
		background: #ffffff;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-width: 320px;
		background: #ffffff;
		color: #191919;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header,
	main,
	.site-footer {
		max-width: 1080px;
		margin: 0 auto;
		padding-inline: 24px;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-block: 32px;
	}

	.brand {
		font-size: 18px;
		font-weight: 700;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 12px 20px;
		color: #666666;
		font-size: 15px;
	}

	nav a {
		white-space: nowrap;
	}

	nav a:hover,
	nav a:focus-visible {
		color: #111111;
	}

	main {
		padding-block: 72px 96px;
	}

	.site-footer {
		padding-block: 28px 40px;
		border-top: 1px solid #e7e7e7;
		color: #767676;
		font-size: 14px;
	}

	.site-footer p {
		margin: 0;
	}

	@media (max-width: 720px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			padding-block-start: 24px;
		}

		nav {
			justify-content: flex-start;
		}

		main {
			padding-block-start: 40px;
		}
	}
</style>
