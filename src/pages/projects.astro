---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

---

<BaseLayout title="Projects | Minjoo's Home">
	<section class="page-section">
		<p class="eyebrow">Projects</p>
		<h1>프로젝트 페이지</h1>
		<p>
			작업한 프로젝트를 카드로 정리하는 공간입니다. 카드에 들어가는 항목은 이번
			수업을 위한 기본 기준이며, 나중에 홈페이지 성격에 맞게 바꿀 수 있습니다.
		</p>
	</section>

	<section class="project-list" aria-label="Project list">
		{projects.map((project) => <ProjectCard project={project} />)}
	</section>
</BaseLayout>

<style>
	.page-section {
		max-width: 760px;
	}

	.eyebrow {
		margin: 0 0 16px;
		color: #767676;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(40px, 6vw, 72px);
		line-height: 1.1;
		letter-spacing: 0;
		word-break: keep-all;
	}

	p {
		margin: 24px 0 0;
		color: #555555;
		font-size: 18px;
		line-height: 1.8;
		word-break: keep-all;
	}

	.project-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-top: 56px;
	}

	@media (max-width: 900px) {
		.project-list {
			grid-template-columns: 1fr;
		}
	}
</style>
