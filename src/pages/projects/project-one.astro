---
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../data/projects.json';

const project = projects.find((item) => item.slug === 'project-one');
---

<BaseLayout title={`${project.title} | Projects`}>
	<section class="project-detail">
		<p class="eyebrow">Project</p>
		<h1>{project.title}</h1>
		<p class="lead">{project.description}</p>

		<section>
			<h2>프로젝트 배경</h2>
			<p>{project.detail}</p>
		</section>

		<section>
			<h2>내가 한 일</h2>
			<p>{project.role}</p>
		</section>

		<section>
			<h2>사용 도구</h2>
			<p>{project.tools.join(', ')}</p>
		</section>

		<section>
			<h2>결과 또는 배운 점</h2>
			<p>{project.result}</p>
		</section>
	</section>
</BaseLayout>

<style>
	.project-detail {
		max-width: 760px;
	}

	.eyebrow {
		margin: 0 0 16px;
		color: #767676;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(40px, 6vw, 72px);
		line-height: 1.1;
		letter-spacing: 0;
	}

	.lead,
	p {
		color: #555555;
		font-size: 18px;
		line-height: 1.8;
		word-break: keep-all;
	}

	.lead {
		margin: 24px 0 56px;
	}

	section section {
		margin-top: 40px;
	}

	h2 {
		margin: 0;
		font-size: 24px;
		line-height: 1.3;
		letter-spacing: 0;
	}

	p {
		margin: 16px 0 0;
	}
</style>
